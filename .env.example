# Copia este archivo a .env y rellena con tus valores reales.
# .env NUNCA se sube al repositorio (ver .gitignore).

# Credenciales de la cuenta local de la camara
# (App Tapo > Camara > Ajustes > Avanzado > Cuenta de la camara)
CAMERA_USER=usuario_rtsp
CAMERA_PASSWORD=contrasena_rtsp

# IP local de la camara en esta red (puede variar entre ubicaciones)
CAMERA_IP=192.168.1.200
